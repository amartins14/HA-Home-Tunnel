<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Set the SHA-256 hash of the one-time code generated by the Home Tunnel HA app. -->
    <add key="HaTunnelBootstrapCodeHash" value="" />
    <!-- Native clients stay disabled; pairing and forwarding state are managed through the app. -->
    <add key="HaTunnelNativeClientsEnabled" value="false" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.8">
      <assemblies><add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" /></assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" executionTimeout="90" enableVersionHeader="false" />
    <customErrors mode="On" />
    <trace enabled="false" />
  </system.web>
  <system.webServer>
    <security><requestFiltering><hiddenSegments><remove segment="App_Data" /><add segment="App_Data" /></hiddenSegments></requestFiltering></security>
    <rewrite><rules><clear />
      <rule name="HA outgoing tunnel" stopProcessing="true">
        <match url="^(?!\.well-known/acme-challenge|_connect\.ashx$|_relay\.ashx$|_whoami\.ashx$|_pair\.ashx$|App_Data/|App_Code/).*" />
        <action type="Rewrite" url="_relay.ashx" appendQueryString="true" />
      </rule>
    </rules></rewrite>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
